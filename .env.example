# Copy to .env:  cp .env.example .env

# --- Temporal (lab/start-temporal.sh) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Lab mode ---
# live = real cEOS devices and Nautobot
# mock = canned outputs from src/netops_temporal/fixtures/ (no lab needed)
LAB_MODE=live

# --- Devices (Arista cEOS in containerlab) ---
DEVICE_USERNAME=admin
DEVICE_PASSWORD=admin
# name=host[:eapi_port[:ssh_port]], comma separated. Ports default to 443 and 22.
# Static IPs from lab/ceos-clab.clab.yml. Behind a jump host? Run lab/tunnels.sh and paste its line here.
DEVICE_HOSTS=bos-rtr-01=172.20.20.2,bos-acc-01=172.20.20.3,nyc-rtr-01=172.20.20.4,nyc-acc-01=172.20.20.5

# --- Nautobot (lab/nautobot/start.sh) ---
NAUTOBOT_URL=http://localhost:8080
NAUTOBOT_TOKEN=0123456789abcdef0123456789abcdef01234567

# --- Where activities write big outputs (backups, show tech) ---
OUTPUT_DIR=output

# --- Mock-mode failure switches (only used when LAB_MODE=mock) ---
# Devices that act unreachable, e.g. MOCK_UNREACHABLE=bos-rtr-01,nyc-rtr-01
MOCK_UNREACHABLE=
# 1 = every device rejects the login
MOCK_AUTH_FAIL=
# Seconds each CLI command takes (makes Day 5 heartbeats visible), e.g. MOCK_CLI_DELAY=3
MOCK_CLI_DELAY=
